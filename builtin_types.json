  "合計": { "を": "配列" },
  "最大": { "を": "配列" },
  "最小": { "を": "配列" },
  "番目取り出す": { "から": "文字列または配列", "を": "整数" },
  "範囲": { "*から": "整数", "*まで": "整数" },
  "反転": { "を": "文字列または配列" },
  "昇順": { "を": "配列" },
  "降順": { "を": "配列" },
